<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- The settings window (adolens setup with the window flag); the program stays a console program for the CLI and MCP. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>adolens</AssemblyName>
    <RootNamespace>AdoLens</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Drawn by packaging/icon/make-icon.ps1; shown in Explorer, Settings -> Apps and the Start menu. -->
    <ApplicationIcon>..\..\packaging\icon\adolens.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <Company>WillowDev</Company>
    <Authors>WillowDev</Authors>
    <Product>ADO Lens</Product>
    <AssemblyTitle>ADO Lens for Azure DevOps</AssemblyTitle>
    <Description>Azure DevOps (work items, boards, wiki, Git and TFVC, pipelines) served to AI assistants over MCP</Description>
    <Copyright>Copyright © 2026 WillowDev</Copyright>
    <Version>0.11.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdoLens.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

</Project>
